# ── Server ──────────────────────────────────────────────────
# Port the Express server listens on
PORT=3000
# Node environment: development | production | test
NODE_ENV=development

# ── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Database ────────────────────────────────────────────────
# PostgreSQL connection string (required)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://kitchenasty:CHANGE_ME@localhost:5432/kitchenasty

# ── Authentication ─────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET=change-this-to-a-random-secret-min-32-chars
# Token expiration (e.g. 7d, 24h, 30m)
JWT_EXPIRES_IN=7d

# ── Security ────────────────────────────────────────────────
# HMAC secret for webhook signature verification
WEBHOOK_SECRET=
# CSRF secret for browser-based form protection
CSRF_SECRET=
# API metric retention in days (default: 90)
API_METRIC_RETENTION_DAYS=90

# ── Stripe ─────────────────────────────────────────────────
# Stripe secret key (sk_live_... or sk_test_...)
STRIPE_SECRET_KEY=sk_test_...
# Stripe webhook signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ── PayPal (optional) ──────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Use sandbox in development, live in production
PAYPAL_SANDBOX=true

# ── WhatsApp ────────────────────────────────────────────────
# Enable WhatsApp notifications
WHATSAPP_ENABLED=true
# Provider: stub | webhook | twilio
WHATSAPP_PROVIDER=stub
# Phone number for notifications
WHATSAPP_NOTIFY_NUMBER=
# Webhook URL for incoming messages
WHATSAPP_WEBHOOK_URL=

# ── Twilio (only if WHATSAPP_PROVIDER=twilio) ─────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+141****1234

# ── Email / SMTP (optional) ────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@example.com

# ── Social Login (optional) ────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ── Public URL ─────────────────────────────────────────────
# Base URL of the API server (used for OAuth callbacks, etc.)
PUBLIC_URL=http://localhost:3000
# Base URL of the storefront (used for CORS, redirects)
STOREFRONT_URL=http://localhost:5174
