PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

DATABASE_URL=postgresql://kitchenasty:kitchenasty@localhost:5432/kitchenasty

# ── Authentication ─────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET=change-this-to-a-random-secret-min-32-chars
JWT_EXPIRES_IN=7d

# ── Security ────────────────────────────────────────────────
# HMAC secret for webhook signature verification
WEBHOOK_SECRET=
# CSRF secret for browser-based form protection
CSRF_SECRET=
# API metric retention in days (default: 90)
API_METRIC_RETENTION_DAYS=90

# ── Stripe ─────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── PayPal (optional) ──────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX=true

# ── WhatsApp ────────────────────────────────────────────────
# provider: stub | webhook | twilio
WHATSAPP_ENABLED=true
WHATSAPP_PROVIDER=stub
WHATSAPP_NOTIFY_NUMBER=
WHATSAPP_WEBHOOK_URL=

# ── Twilio (only if WHATSAPP_PROVIDER=twilio) ─────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155551234

# ── Email / SMTP (optional) ────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@example.com

# ── Social Login (optional) ────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ── Public URL ─────────────────────────────────────────────
PUBLIC_URL=http://localhost:5174
STOREFRONT_URL=http://localhost:5174
