# ── Server ──────────────────────────────────────────────────
# Port the Express server listens on
PORT=3000
# Node environment: development | production | test
NODE_ENV=development

# ── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Database ────────────────────────────────────────────────
# PostgreSQL connection string (required)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://kitchenasty:CHANGE_ME@localhost:5432/kitchenasty

# ── Authentication ─────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET=change-this-to-a-random-secret-min-32-chars
# Token expiration (e.g. 7d, 24h, 30m)
JWT_EXPIRES_IN=7d

# ── Security ────────────────────────────────────────────────
# HMAC secret for webhook signature verification
WEBHOOK_SECRET=
# CSRF secret for browser-based form protection
CSRF_SECRET=
# API metric retention in days (default: 90)
API_METRIC_RETENTION_DAYS=90
# Log level (debug | info | warn | error)
LOG_LEVEL=info

# ── Turnstile CAPTCHA (optional) ───────────────────────────
# Enable/disable adaptive captcha
CAPTCHA_ENABLED=false
# Cloudflare Turnstile site key (public)
CAPTCHA_SITE_KEY=
# Cloudflare Turnstile secret key
CAPTCHA_SECRET_KEY=

# ── Stripe ─────────────────────────────────────────────────
# Stripe secret key (sk_live_... or sk_test_...)
STRIPE_SECRET_KEY=sk_test_...
# Stripe webhook signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ── WhatsApp (DISABLED — re-enable only when needed) ───────
# Master switch for the WhatsApp integration (currently deactivated)
WHATSAPP_ENABLED=false

# ── Email / SMTP (optional) ────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@example.com

# ── Social Login (optional) ────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ── Public URL ─────────────────────────────────────────────
# Base URL of the API server (used for OAuth callbacks, etc.)
PUBLIC_URL=http://localhost:3000
# Base URL of the storefront (used for CORS, redirects)
STOREFRONT_URL=http://localhost:5174
# Base URL of the admin panel (used for redirects)
ADMIN_URL=http://localhost:5173
# Public site URL (used as fallback in links)
KINGFOOD_SITE=http://localhost:5174
# Internal API URL (used by automation/king-agent)
KINGFOOD_API_URL=http://localhost:3000

# ── AI / Ollama (king-agent — used by WhatsApp bot, disabled) ──
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
OLLAMA_BASE_URL=
OLLAMA_MODEL=
