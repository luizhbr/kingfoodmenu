{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "packages/server/Dockerfile"
  },
  "deploy": {
    "startCommand": "npx prisma migrate deploy --schema prisma/schema.prisma && node packages/server/dist/index.js",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "healthcheck": {
      "type": "HTTP",
      "path": "/api/health",
      "port": 3000,
      "timeout": 30
    }
  }
}
