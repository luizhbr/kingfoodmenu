# ── Docker Compose Environment ──────────────────────────────
# Copy this file to .env and fill in the values.
# Never commit your .env file to version control.

# ── Database ───────────────────────────────────────────────
POSTGRES_USER=kitchenasty
POSTGRES_PASSWORD=CHANGE_ME_to_a_strong_random_password
POSTGRES_DB=kitchenasty

# ── Authentication ─────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_to_a_random_secret_min_32_chars
JWT_EXPIRES_IN=7d

# ── Security ────────────────────────────────────────────────
# HMAC secret for webhook signature verification (optional in dev)
WEBHOOK_SECRET=
# CSRF secret for browser-based form protection (optional in dev)
CSRF_SECRET=

# ── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Node Environment ────────────────────────────────────────
NODE_ENV=development

# ── API Metric Retention ────────────────────────────────────
# Days to retain API metrics before auto-cleanup (default: 90)
API_METRIC_RETENTION_DAYS=90

# ── Stripe (optional) ──────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── WhatsApp (optional) ────────────────────────────────────
WHATSAPP_ENABLED=true
WHATSAPP_PROVIDER=stub
WHATSAPP_NOTIFY_NUMBER=
WHATSAPP_WEBHOOK_URL=

# ── Twilio (optional, only if WHATSAPP_PROVIDER=twilio) ───
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
